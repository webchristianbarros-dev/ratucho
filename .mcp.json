{
  "mcpServers": {
    "unreal": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp"
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--python", "3.12", "blender-mcp@2.0.0"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876"
      }
    }
  }
}
